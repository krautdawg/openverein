{
  "name": "openverein",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source club management for German registered associations (e.V.)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "docker compose up -d db mail && npm run migrate && concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/index.ts",
    "migrate": "node --env-file-if-exists=.env src/server/migrate.ts",
    "seed:demo": "node --env-file-if-exists=.env src/server/demo/seed-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "openapi": "node src/server/openapi-dump.ts > openapi.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.104.5",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "kysely": "^0.29.7",
    "lean-qr": "^2.7.4",
    "libxml2-wasm": "^0.7.2",
    "lucide-react": "^1.61.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "source-sans": "^3.52.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
