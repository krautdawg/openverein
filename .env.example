# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://openverein:openverein@localhost:54329/openverein
# Test database (created automatically by the test setup)
TEST_DATABASE_URL=postgres://openverein:openverein@localhost:54329/openverein_test
PORT=3300
# API requests per minute and client address (default 600)
# RATE_LIMIT_PER_MINUTE=600
# Outgoing mail; Mailpit from docker-compose catches everything locally
SMTP_URL=smtp://localhost:11025
# Public address of this installation, used for links in e-mails (invitations, unsubscribe).
PUBLIC_URL=http://localhost:3300
# Uploaded files (content-addressed). Relative paths start at the repo root.
FILES_DIR=data/files
MAIL_FROM="OpenVerein <verein@example.org>"
# Set to true behind HTTPS
COOKIE_SECURE=false
# Public demo mode: seeded fake club, banner, resettable
DEMO_MODE=false
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs). Empty = none.
TRUST_PROXY=
# Key for encrypted bank data (IBANs, SEPA files). Generate with: openssl rand -base64 32
# Keep it with your backups: without it, encrypted fields cannot be read. Required in production.
DATA_KEY=
# Public demo: reset interval in hours (0 = never)
DEMO_RESET_HOURS=24
# Webhooks to http or private addresses (development only; production refuses them as SSRF protection)
# WEBHOOKS_ALLOW_PRIVATE=false

# Managed hosting: several clubs on one installation, each under its own host name (docs/operations.md).
# Clubs are created through the operator API with the X-Operator-Token header; the open setup page is closed.
MULTI_TENANT=false
# At least 32 characters; keep it in your secret store, never in the repository.
OPERATOR_TOKEN=
