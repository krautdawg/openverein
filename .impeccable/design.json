  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action per region: page head, sheet foot, inline form.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M5 12h14M12 5v14\"/></svg>Mitglied anlegen</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 16px;border-radius:4px;border:1px solid #858b83;background:#fff;color:#14202e;font:600 14px 'Source Sans 3 Variable','Source Sans 3',system-ui,sans-serif;cursor:pointer;transition:background 150ms cubic-bezier(0.2,0.8,0.2,1),border-color 150ms cubic-bezier(0.2,0.8,0.2,1)}.ds-btn:focus-visible{outline:2px solid #bf3a13;outline-offset:2px}.ds-btn-primary{background:#bf3a13;border-color:#bf3a13;color:#fff}.ds-btn-primary:hover{background:#a5310f;border-color:#a5310f}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Secondary actions such as CSV export.",
      "html": "<button class=\"ds-btn2\">CSV</button>",
      "css": ".ds-btn2{height:36px;padding:0 16px;border-radius:4px;border:1px solid #858b83;background:#fff;color:#14202e;font:600 14px 'Source Sans 3 Variable',system-ui,sans-serif;cursor:pointer;transition:background 150ms}.ds-btn2:hover{background:#eceee9}.ds-btn2:focus-visible{outline:2px solid #bf3a13;outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Cancel and quiet row actions.",
      "html": "<button class=\"ds-btn-ghost\">Abbrechen</button>",
      "css": ".ds-btn-ghost{height:36px;padding:0 16px;border-radius:4px;border:1px solid transparent;background:transparent;color:#14202e;font:600 14px 'Source Sans 3 Variable',system-ui,sans-serif;cursor:pointer}.ds-btn-ghost:hover{background:#eceee9}.ds-btn-ghost:focus-visible{outline:2px solid #bf3a13;outline-offset:2px}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Fields, search and inline edit.",
      "html": "<label class=\"ds-field\"><span>Nachname</span><input class=\"ds-input\" placeholder=\"Becker\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:4px;font:600 14px 'Source Sans 3 Variable',system-ui,sans-serif;color:#14202e}.ds-input{height:36px;padding:0 12px;border:1px solid #858b83;border-radius:4px;background:#fff;color:#14202e;font:400 15px 'Source Sans 3 Variable',system-ui,sans-serif;transition:border-color 150ms}.ds-input::placeholder{color:#5f6874}.ds-input:hover{border-color:#5f6874}.ds-input:focus-visible{outline:2px solid #bf3a13;outline-offset:0;border-color:#bf3a13}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "rail",
      "description": "Hallenblau side rail; current link carries a 24px accent court line.",
      "html": "<nav class=\"ds-rail\"><a href=\"#\">Übersicht</a><a href=\"#\" aria-current=\"page\">Mitglieder</a><a href=\"#\">Gruppen</a></nav>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:2px;width:208px;padding:12px;background:#12355b;font:400 15px 'Source Sans 3 Variable',system-ui,sans-serif}.ds-rail a{position:relative;display:flex;align-items:center;min-height:36px;padding:0 12px;border-radius:4px;color:#a9bdd2;text-decoration:none;transition:background 150ms,color 150ms}.ds-rail a:hover{color:#e9eff6;background:rgb(255 255 255/.06)}.ds-rail a:focus-visible{outline:2px solid #bf3a13;outline-offset:2px}.ds-rail a[aria-current=page]{color:#fff;background:#1b4471}.ds-rail a[aria-current=page]::after{content:'';position:absolute;left:12px;right:12px;bottom:4px;height:2px;background:linear-gradient(to right,#bf3a13 24px,transparent 24px)}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segmented-pressed",
      "description": "List view switch; pressed segment in Hall Ink.",
      "html": "<div class=\"ds-seg\"><button aria-pressed=\"true\">Aktuell</button><button aria-pressed=\"false\">Aktiv</button><button aria-pressed=\"false\">Ehemalige</button></div>",
      "css": ".ds-seg{display:inline-flex;border:1px solid #858b83;border-radius:4px;background:#fff;padding:2px}.ds-seg button{border:0;background:transparent;font:400 14px 'Source Sans 3 Variable',system-ui,sans-serif;padding:0 12px;height:30px;border-radius:3px;color:#47525f;cursor:pointer}.ds-seg button[aria-pressed=true]{background:#14202e;color:#fff}.ds-seg button:hover:not([aria-pressed=true]){background:#eceee9}.ds-seg button:focus-visible{outline:2px solid #bf3a13;outline-offset:2px}"
    },
    {
      "name": "Group Badge (court line)",
      "kind": "custom",
      "refersTo": "court-gruen",
      "description": "Signature: a 14x2px stroke in the group colour before the name.",
      "html": "<span class=\"ds-court\" style=\"--court:#2b7a4b\">Fußball</span> <span class=\"ds-court\" style=\"--court:#c99a06\">Jugend</span>",
      "css": ".ds-court{display:inline-flex;align-items:center;gap:6px;font:400 14px 'Source Sans 3 Variable',system-ui,sans-serif;color:#14202e;margin-right:12px}.ds-court::before{content:'';width:14px;height:2px;border-radius:1px;background:var(--court,#6b7480)}"
    },
    {
      "name": "Membership Court Lines",
      "kind": "custom",
      "refersTo": "court-blau",
      "description": "Signature: group history as coloured lines on one time axis; open spells end in an arrowhead.",
      "html": "<div class=\"ds-cl\"><div class=\"ds-cl-row\" style=\"--court:#2b7a4b\"><div class=\"ds-cl-label\"><span>Fußball</span><span>01.03.2018 – heute</span></div><div class=\"ds-cl-track\"><div class=\"ds-cl-line ds-open\" style=\"left:0;width:100%\"></div></div></div><div class=\"ds-cl-row\" style=\"--court:#1f5fa8\"><div class=\"ds-cl-label\"><span>Turnen</span><span>01.09.2019 – 31.12.2022</span></div><div class=\"ds-cl-track\"><div class=\"ds-cl-line\" style=\"left:20%;width:45%\"></div></div></div></div>",
      "css": ".ds-cl{width:420px;font:400 14px 'Source Sans 3 Variable',system-ui,sans-serif;color:#14202e}.ds-cl-row{display:grid;gap:2px;padding:6px 0}.ds-cl-label{display:flex;justify-content:space-between}.ds-cl-label span+span{color:#5f6874;font-variant-numeric:tabular-nums}.ds-cl-track{position:relative;height:3px;background:repeating-linear-gradient(to right,#d8dbd4 0 4px,transparent 4px 8px)}.ds-cl-line{position:absolute;top:0;height:3px;border-radius:2px;background:var(--court)}.ds-open::after{content:'';position:absolute;right:-6px;top:-3px;width:7px;height:9px;background:var(--court);clip-path:polygon(0 0,100% 50%,0 100%)}"
    },
    {
      "name": "Dense Table Row",
      "kind": "card",
      "refersTo": "table-row",
      "description": "44px rows, hairlines, hover wash, row actions on hover/focus.",
      "html": "<table class=\"ds-table\"><thead><tr><th>Name</th><th class=\"n\">Nr.</th><th></th></tr></thead><tbody><tr tabindex=\"0\"><td><b>Becker, Jonas</b></td><td class=\"n\">0116</td><td><button class=\"ds-ra\">Bearbeiten</button></td></tr><tr tabindex=\"0\" aria-selected=\"true\"><td><b>Braun, Ole</b></td><td class=\"n\">0119</td><td><button class=\"ds-ra\">Bearbeiten</button></td></tr></tbody></table>",
      "css": ".ds-table{width:420px;border-collapse:collapse;background:#fff;border:1px solid #d8dbd4;font:400 14px 'Source Sans 3 Variable',system-ui,sans-serif;color:#14202e}.ds-table th{text-align:left;font-size:13px;font-weight:600;color:#47525f;padding:8px 12px;border-bottom:1px solid #d8dbd4}.ds-table td{height:44px;padding:0 12px;border-bottom:1px solid #d8dbd4}.ds-table .n{text-align:right;font-variant-numeric:tabular-nums}.ds-table tbody tr{transition:background 150ms}.ds-table tbody tr:hover{background:#eceee9}.ds-table tbody tr[aria-selected=true]{background:#fbe9e3}.ds-table tbody tr:focus-visible{outline:2px solid #bf3a13;outline-offset:-2px}.ds-ra{opacity:0;border:0;background:none;color:#47525f;text-decoration:underline;font:inherit;cursor:pointer;transition:opacity 150ms}.ds-table tr:hover .ds-ra,.ds-table tr:focus-within .ds-ra{opacity:1}"
    },
    {
      "name": "Portal Tab Bar",
      "kind": "nav",
      "refersTo": "portal-tabs",
